{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ingest-route": {
        "ClusterId": "ingestion-cluster",
        "Match": {
          "Path": "/api/ingest/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "ingestion-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "notify-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notify/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ingestion-cluster": {
        "Destinations": {
          "ingestion": {
            "Address": "http://ingestion-service:5001"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://notification-service:5002"
          }
        }
      }
    }
  }
}
